#!/usr/bin/env bash
set -euo pipefail

reason="${1:-}"
if [[ -z "${reason}" ]]; then
  echo "Usage: oparch-snapshot-system <reason>" >&2
  exit 1
fi

timestamp="$(date +%Y%m%d-%H%M%S)"
slug="$(printf '%s' "${reason}" | tr '[:space:]/' '__' | tr -cd '[:alnum:]_.-')"
[[ -n "${slug}" ]] || slug="manual"
target="/snapshots/system/${timestamp}-${slug}"

btrfs subvolume snapshot -r / "${target}"
