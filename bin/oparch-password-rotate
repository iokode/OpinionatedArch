#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/log.sh
source "${SCRIPT_DIR}/../lib/log.sh"

usage() {
  cat <<'USAGE_EOF'
Usage: oparch-password-rotate [--old-password <password> --new-password <password>]

Rotate the shared secret used by:
- LUKS passphrase on the encrypted root device
- All users in group login-users

If no password parameters are provided, the command reads both values with read -s.
USAGE_EOF
}

ARG_OLD_PASSWORD=""
ARG_NEW_PASSWORD=""

parse_args() {
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --old-password)
        [[ "$#" -ge 2 ]] || die "--old-password requires a value."
        ARG_OLD_PASSWORD="$2"
        shift 2
        ;;
      --new-password)
        [[ "$#" -ge 2 ]] || die "--new-password requires a value."
        ARG_NEW_PASSWORD="$2"
        shift 2
        ;;
      -h|--help)
        usage
        exit 0
        ;;
      *)
        die "Unknown argument: $1"
        ;;
    esac
  done

  if [[ -n "${ARG_OLD_PASSWORD}" && -z "${ARG_NEW_PASSWORD}" ]]; then
    die "--new-password is required when --old-password is provided."
  fi

  if [[ -z "${ARG_OLD_PASSWORD}" && -n "${ARG_NEW_PASSWORD}" ]]; then
    die "--old-password is required when --new-password is provided."
  fi
}

read_passwords_if_needed() {
  if [[ -n "${ARG_OLD_PASSWORD}" && -n "${ARG_NEW_PASSWORD}" ]]; then
    return 0
  fi

  read -r -s -p "Old shared secret: " ARG_OLD_PASSWORD
  printf '\n' >&2
  read -r -s -p "New shared secret: " ARG_NEW_PASSWORD
  printf '\n' >&2
}

get_luks_device_for_root() {
  local root_source=""
  local mapping_name=""
  local luks_device=""

  root_source="$(findmnt -n -o SOURCE /)"
  root_source="${root_source%%[*}"

  if [[ "${root_source}" == /dev/mapper/* ]]; then
    mapping_name="${root_source##*/}"
    luks_device="$(cryptsetup status "${mapping_name}" | awk '/device:/ {print $2; exit}')"
    [[ -n "${luks_device}" ]] || die "Unable to resolve LUKS backing device from mapper: ${root_source}"
    printf '%s\n' "${luks_device}"
    return 0
  fi

  printf '%s\n' "${root_source}"
}

list_login_users() {
  getent group login-users | awk -F: '{print $4}' | tr ',' '\n' | sed '/^$/d'
}

rotate_luks_passphrase() {
  local luks_device="$1"
  local old_password="$2"
  local new_password="$3"

  cryptsetup luksAddKey "${luks_device}" \
    --key-file <(printf '%s' "${old_password}") \
    --new-keyfile <(printf '%s' "${new_password}")

  cryptsetup open --test-passphrase "${luks_device}" \
    --key-file <(printf '%s' "${new_password}")

  cryptsetup luksRemoveKey "${luks_device}" \
    --key-file <(printf '%s' "${old_password}")
}

update_login_users_password() {
  local new_password="$1"
  local -a users=()
  local user=""

  while IFS= read -r user; do
    [[ -n "${user}" ]] || continue
    users+=("${user}")
  done < <(list_login_users)

  [[ "${#users[@]}" -gt 0 ]] || die "No users found in login-users group."

  {
    for user in "${users[@]}"; do
      printf '%s:%s\n' "${user}" "${new_password}"
    done
  } | chpasswd
}

main() {
  local luks_device=""

  require_root_or_warn_exit "This command must run as root."
  parse_args "$@"
  read_passwords_if_needed

  luks_device="$(get_luks_device_for_root)"
  rotate_luks_passphrase "${luks_device}" "${ARG_OLD_PASSWORD}" "${ARG_NEW_PASSWORD}"
  update_login_users_password "${ARG_NEW_PASSWORD}"

  log "Shared secret rotated for LUKS and login-users."
}

main "$@"
