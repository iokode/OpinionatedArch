pkgname=oparch-keyring
pkgver=0.1.0dev3
pkgrel=1
pkgdesc="Public key the oparch repository is signed with"
arch=('any')
url='https://github.com/iokode/OpinionatedArch'
license=('BSD-2-Clause')
depends=('pacman' 'gnupg')
install="${pkgname}.install"
# Named `.gpg` and not `.asc` because makepkg reads a source ending in `.asc`
# as a detached signature for another source, and would look for a file this
# package does not have. The content is armoured all the same, so that what is
# committed to this repository is text.
source=('oparch.gpg')
sha256sums=('SKIP')

package() {
    # Where pacman looks for keyrings that are not its own: `pacman-key
    # --populate` reads every `.gpg` here together with the `-trusted` file
    # beside it. That is how a key reaches a keyring somebody else makes, which
    # is the case that matters — the live medium has no keyring while the image
    # is being built, and creates one at boot.
    install -Dm644 "${srcdir}/oparch.gpg" \
        "${pkgdir}/usr/share/pacman/keyrings/oparch.gpg"

    # The fingerprint is taken from the key rather than written down, so that
    # replacing the key cannot leave the two disagreeing. It is the primary's,
    # which is what is signed; trust reaches the subkey that signs packages
    # through the binding the primary made for it.
    #
    # gpg is given a directory of its own because it makes one for itself
    # before it will do anything at all, including reading a file it is handed.
    # It goes in the directory makepkg gave this build, which is the one place
    # a package build is entitled to write: `/tmp` belongs to whoever is
    # running the build, and under fakeroot it is not always theirs to use.
    local home fingerprint
    home="${srcdir}/gnupg"
    install -dm700 "$home"
    fingerprint="$(GNUPGHOME="$home" gpg --with-colons --import-options show-only \
        --import < "${srcdir}/oparch.gpg" | awk -F: '/^fpr:/ { print $10; exit }')"
    rm -rf "$home"
    [ -n "$fingerprint" ] || return 1

    # `4` is full trust, which is what a key has to carry for pacman to accept
    # what it signed.
    printf '%s:4:\n' "$fingerprint" \
        > "${pkgdir}/usr/share/pacman/keyrings/oparch-trusted"
}
