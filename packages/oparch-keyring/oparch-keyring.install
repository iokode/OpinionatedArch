# The key is installed where pacman looks for keyrings that are not its own,
# so what puts it into a keyring is pacman's own populate rather than anything
# written here. That is what makes it reach the live medium: the image has no
# keyring while it is being built, and `pacman-key --init` followed by a bare
# `--populate` creates one at boot out of every keyring found there, this one
# among them.
#
# What is left for this scriptlet is the other case. A system that already has
# a keyring is not going to be booted again to pick this up, so installing the
# package takes effect where it is installed.

_populate() {
    # Only where there is a keyring to populate. Where there is not, this would
    # fail for want of one, and the key is already where whoever makes it will
    # find it.
    if pacman-key -l >/dev/null 2>&1; then
        pacman-key --populate oparch
    fi
}

post_install() {
    _populate
}

post_upgrade() {
    _populate
}
