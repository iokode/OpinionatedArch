pkgname=oparch-work-context-list
pkgver=0.1.0dev3
pkgrel=1
pkgdesc="Lists the work contexts of the machine it is run on"
arch=('x86_64')
url='https://github.com/iokode/OpinionatedArch'
license=('BSD-2-Clause')

# No separate package of debug symbols, which makepkg would otherwise make and
# the repository would then hold alongside every tool it publishes.
#
# And nothing is stripped. `baml pack` leaves the program this tool runs in
# sections of the binary it produces, and `strip` takes them out: what is left
# starts, finds no program inside itself, and says so.
options=('!debug' '!strip')

# What the Requirements section of docs/tools/work-context/list/000-command.md
# names. It is on any Arch system, and it is declared anyway because nothing is
# arranged so that it is absent.
depends=('glibc')

# Built by the workflow and left beside this file. There is no build() here:
# the toolchain that produces this binary is not an Arch package, so makepkg
# cannot compile it and only packages what it is handed.
source=('oparch-work-context-list')
sha256sums=('SKIP')

package() {
    install -Dm755 "${srcdir}/oparch-work-context-list" \
        "${pkgdir}/usr/bin/oparch-work-context-list"
}
