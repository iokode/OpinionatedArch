pkgname=oparch-installer
pkgver=0.1.0dev10
pkgrel=1
pkgdesc="Installs OpinionatedArch onto a machine, from a live environment"
arch=('x86_64')
url='https://github.com/iokode/OpinionatedArch'
license=('BSD-2-Clause')

# No separate package of debug symbols, which makepkg would otherwise make and
# the repository would then hold alongside every tool it publishes.
#
# And nothing is stripped. `baml pack` leaves the program `oparch-installer`
# runs in sections of the binary it produces, and `strip` takes them out: what
# is left starts, finds no program inside itself, and says so.
options=('!debug' '!strip')

# What the Requirements sections of docs/tools/installer/unattended/000-command.md
# and docs/tools/installer/interactive/000-command.md name. The two tools
# are there because the installer calls them by name and needs them on PATH;
# the BAML runtime because the interactive installer's host loads it; the rest
# are what it calls without checking whether they are present, which is what
# lets a live environment be given rather than examined.
depends=('oparch-assets'
         'oparch-baml-runtime'
         'oparch-return-message-render'
         'oparch-dotfiles-sync'
         'git'
         'fontconfig'
         'gptfdisk'
         'cryptsetup'
         'btrfs-progs'
         'dosfstools'
         'arch-install-scripts'
         'util-linux'
         'parted'
         'systemd'
         'kbd'
         'curl'
         'tar'
         'age>=1.3.1')

# The unattended installer, which `baml pack` made and which carries its runtime
# inside it, and the interactive one, which has a host, are built by the
# workflow and left beside this file; the wrapper that points the interactive
# one at the BAML runtime its host loads is committed beside it.
source=('oparch-installer'
        'oparch-installer-interactive'
        'oparch-installer-interactive.sh')
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/oparch-installer" \
        "${pkgdir}/usr/bin/oparch-installer"

    # The interactive binary sits beside the library oparch-baml-runtime puts
    # there, out of the way, and what goes on PATH is the wrapper that points
    # the one at the other.
    install -Dm755 "${srcdir}/oparch-installer-interactive" \
        "${pkgdir}/usr/lib/oparch/oparch-installer-interactive"
    install -Dm755 "${srcdir}/oparch-installer-interactive.sh" \
        "${pkgdir}/usr/bin/oparch-installer-interactive"
}
