pkgname=oparch-dotfiles-sync
pkgver=0.1.0dev1
pkgrel=2
pkgdesc="Applies a dotfiles package to the machine it is run on"
arch=('x86_64')
url='https://github.com/iokode/OpinionatedArch'
license=('BSD-2-Clause')

# No separate package of debug symbols, which makepkg would otherwise make and
# the repository would then hold alongside every tool it publishes.
#
# And nothing is stripped. `baml pack` leaves the program this tool runs in
# sections of the binary it produces, and `strip` takes them out: what is left
# starts, finds no program inside itself, and says so. Every copy of this
# package published before this line was that.
options=('!debug' '!strip')

# What the Requirements section of docs/tools/oparch-dotfiles-sync/000-command.md
# names. Every one of them is on any Arch system, and they are declared anyway
# because nothing is arranged so that they are absent.
depends=('pacman' 'glibc' 'coreutils')

# Built by the workflow and left beside this file. There is no build() here:
# the toolchain that produces these binaries is not an Arch package, so
# makepkg cannot compile them and only packages what it is handed.
source=('oparch-dotfiles-sync')
sha256sums=('SKIP')

package() {
    install -Dm755 "${srcdir}/oparch-dotfiles-sync" \
        "${pkgdir}/usr/bin/oparch-dotfiles-sync"
}
